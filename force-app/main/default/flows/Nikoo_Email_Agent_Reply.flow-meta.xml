            </value>
        </inputParameters>
        <inputParameters>
            <name>summary</name>
            <value>
                <stringValue>The email agent could not process this email automatically. Please reply manually.</stringValue>
            </value>
        </inputParameters>
        <nameSegment>ResiAgentEscalateCase</nameSegment>
