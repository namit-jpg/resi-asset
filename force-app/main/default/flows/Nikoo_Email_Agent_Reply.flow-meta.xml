    <recordUpdates>
        <description>Committed in the triggering transaction, so the case shows Agent Working while the agent composes its reply.</description>
        <name>Mark_Agent_Working</name>
        <label>Mark Agent Working</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
