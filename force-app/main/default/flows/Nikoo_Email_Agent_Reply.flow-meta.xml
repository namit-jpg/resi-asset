        </outputParameters>
    </actionCalls>
    <actionCalls>
        <name>Send_Reply</name>
        <label>Send Reply</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>ResiAgentSendReply</actionName>
        <actionType>apex</actionType>
        <flowTransactionModel>CurrentTransaction</flowTransactionModel>
        <inputParameters>
            <name>caseId</name>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </inputParameters>
        <inputParameters>
            <name>replyBody</name>
            <value>
                <elementReference>AgentResponse</elementReference>
            </value>
        </inputParameters>
        <nameSegment>ResiAgentSendReply</nameSegment>
        <offset>0</offset>
    </actionCalls>
    <apiVersion>66.0</apiVersion>
    <decisions>
        <name>Should_Agent_Reply</name>
        <label>Should Agent Reply?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Skip</defaultConnectorLabel>
        <rules>
            <name>Reply</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.OwnerId</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_Agent_User.Id</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>RecipientEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>IsAutomatedSender</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Invoke_AI_Agent</targetReference>
            </connector>
            <label>Reply</label>
        </rules>
    </decisions>
    <description>Marks the case Agent Working, then runs the Nikoo Homes Email Support Agent on new email cases from the Nikoo Homes Customer Care routing address (03namit@gmail.com, owned by the agent user) and emails the reply to the customer. Skips automated senders to avoid mail loops.</description>
    <environments>Default</environments>
    <formulas>
        <name>AgentPrompt</name>
        <dataType>String</dataType>
        <expression>&quot;Case Id: &quot; &amp; {!$Record.Id} &amp; BR() &amp;
&quot;Case Number: &quot; &amp; {!$Record.CaseNumber} &amp; BR() &amp;
&quot;Customer Email: &quot; &amp; {!RecipientEmail} &amp; BR() &amp;
&quot;Subject: &quot; &amp; {!$Record.Subject} &amp; BR() &amp;
&quot;Customer Email body: &quot; &amp; {!$Record.Description}</expression>
    </formulas>
    <formulas>
        <name>IsAutomatedSender</name>
        <dataType>Boolean</dataType>
        <expression>OR(
CONTAINS(LOWER({!RecipientEmail}), &quot;noreply&quot;),
CONTAINS(LOWER({!RecipientEmail}), &quot;no-reply&quot;),
CONTAINS(LOWER({!RecipientEmail}), &quot;donotreply&quot;),
CONTAINS(LOWER({!RecipientEmail}), &quot;mailer-daemon&quot;),
CONTAINS(LOWER({!RecipientEmail}), &quot;postmaster&quot;),
CONTAINS(LOWER({!RecipientEmail}), &quot;salesforce.com&quot;),
LOWER({!RecipientEmail}) = &quot;03namit@gmail.com&quot;
)</expression>
    </formulas>
    <formulas>
        <name>RecipientEmail</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!$Record.SuppliedEmail}, {!$Record.Contact.Email})</expression>
    </formulas>
    <interviewLabel>Nikoo Email Agent Reply {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Nikoo Email Agent Reply</label>
    <processMetadataValues>
