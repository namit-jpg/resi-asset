<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Customer Booking Form</masterLabel>
    <description>Public booking form opened from the opportunity's unique link (?t=token).</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <!-- Lets staff open the same form inside Salesforce (?c__t=token) when the public site is unavailable. -->
        <target>lightning__UrlAddressable</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="token" type="String" label="Token (testing only)" description="Leave blank. The token comes from the link's ?t= parameter."/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>