<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>WarpDrive Glass Sales Dashboard</masterLabel>
    <description>Frosted-glass sales dashboard with filters: KPIs, target vs actual, funnel, sources, projects, pipeline, executives, lost reasons, stock, cancellations.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="eyebrow" type="String" label="Eyebrow text" default="Nikoo Homes · Residential sales"/>
            <property name="defaultPeriod" type="String" label="Default period" datasource="month,quarter,fy" default="fy"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>