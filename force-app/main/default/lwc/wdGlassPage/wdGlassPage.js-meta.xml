<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>62.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>WarpDrive Glass List Page</masterLabel>
    <description>Frosted-glass pipeline page with KPI cards and a searchable list for Leads, Inventory, Bookings or EOI vouchers.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__HomePage</target>
        <target>lightning__Tab</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__HomePage">
            <property name="pageKey" type="String" label="Page" datasource="leads,inventory,bookings,eoi" default="leads"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>