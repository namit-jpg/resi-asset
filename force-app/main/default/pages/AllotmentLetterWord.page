<apex:page controller="AllotmentLetterController" contentType="application/msword#Allotment_Letter.doc"
           applyBodyTag="false" showHeader="false">
    <head>
        <style type="text/css">
            @page {
            size: A4;
            margin: 2cm;
            }
            body {
            font-family: 'Arial', sans-serif;
            font-size: 11pt;
            color: #333;
            line-height: 1.3;
            }
            .header {
            text-align: center;
            margin-bottom: 20px;
            }
            .header h1 {
            margin: 0;
            font-size: 14pt;
            font-weight: bold;
            }
            .header p {
            margin: 2px 0;
            font-size: 11pt;
            }
            .title {
            text-align: center;
            font-size: 12pt;
            font-weight: bold;
            text-decoration: underline;
            margin: 20px 0;
            }
            .section {
            margin-top: 15px;
            margin-bottom: 10px;
            }
            .section p, .section li {
            text-align: justify;
            line-height: 1.5;
            margin-bottom: 5px;
            }
            .terms-list {
            padding-left: 20px;
            }
            .terms-list li {
            margin-bottom: 10px;
            }
            .note-list li {
            margin-bottom: 5px;
            }
            .schedule-title {
            font-size: 14pt;
            font-weight: bold;
            text-align: center;
            margin: 20px 0;
            text-decoration: underline;
            }
            .schedule-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            }
            .schedule-table th, .schedule-table td {
            border: 1px solid #000;
            padding: 8px;
            text-align: left;
            }
            .schedule-table th {
            background-color: #f2f2f2;
            font-weight: bold;
            }
        </style>
    </head>
    
    <body>
        <!-- Header -->
        <div class="header">
            <c:WDDocLogo word="true"/>
            <h1>WarpDrive Tech Works</h1>
            <p><strong>{!bookingRecord.Project__r.Name}</strong></p>
            <p><strong>{!bookingRecord.Project__r.Address__c}</strong></p>
        </div>
        
        <!-- Title -->
        <div class="title">ALLOTMENT LETTER</div>
        
        <!-- Address & Date -->
        <p>
            To:<br/>
            <strong>{!bookingRecord.Account_Id__r.Name}</strong><br/>
            <!-- ✅ Added Co-Applicant display -->
            <apex:outputPanel rendered="{!NOT(
                                        AND(
                                        ISBLANK(bookingRecord.Co_Applicant_1__r.Name),
                                        ISBLANK(bookingRecord.Co_Applicant_2__r.Name),
                                        ISBLANK(bookingRecord.Co_Applicant_3__r.Name),
                                        ISBLANK(bookingRecord.Co_Applicant_4__r.Name),
                                        ISBLANK(bookingRecord.Co_Applicant_5__r.Name)
                                        )
                                        )}">
                <br/>
                <strong>Co-Applicant(s):</strong><br/>
                <apex:outputPanel rendered="{!NOT(ISBLANK(bookingRecord.Co_Applicant_1__r.Name))}">
                    {!bookingRecord.Co_Applicant_1__r.Name}<br/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!NOT(ISBLANK(bookingRecord.Co_Applicant_2__r.Name))}">
                    {!bookingRecord.Co_Applicant_2__r.Name}<br/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!NOT(ISBLANK(bookingRecord.Co_Applicant_3__r.Name))}">
                    {!bookingRecord.Co_Applicant_3__r.Name}<br/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!NOT(ISBLANK(bookingRecord.Co_Applicant_4__r.Name))}">
                    {!bookingRecord.Co_Applicant_4__r.Name}<br/>
                </apex:outputPanel>
                <apex:outputPanel rendered="{!NOT(ISBLANK(bookingRecord.Co_Applicant_5__r.Name))}">
                    {!bookingRecord.Co_Applicant_5__r.Name}<br/>
                </apex:outputPanel>
            </apex:outputPanel>
            <strong>{!bookingRecord.Account_Id__r.BillingStreet}</strong><br/>
            <strong>{!bookingRecord.Account_Id__r.BillingCity}, {!bookingRecord.Account_Id__r.BillingState}, {!bookingRecord.Account_Id__r.BillingPostalCode}</strong><br/>
            Ph: <strong>{!bookingRecord.Account_Id__r.Phone}</strong><br/>
            Date: <strong>{!DAY(TODAY())}/{!MONTH(TODAY())}/{!YEAR(TODAY())}</strong>
        </p>
        
        <!-- Salutation -->
        <div class="section">
            <p>
                Dear <strong>
                {!IF(NOT(ISBLANK(bookingRecord.Account_Id__r.Name)),
                TRIM(RIGHT(bookingRecord.Account_Id__r.Name,
                LEN(bookingRecord.Account_Id__r.Name) - FIND(' ', bookingRecord.Account_Id__r.Name))),
                'Customer')}
                </strong>,
            </p>
            
            <p><strong>Sub: Allotment of residential unit in the Project known as "{!bookingRecord.Project__r.Name}" (RERA Registration Number <strong>{!bookingRecord.Unit_Id__r.Tower__r.RERA_Number__c}</strong>) situated at {!bookingRecord.Project__r.Address__c}.</strong></p>
            
            <p>
                With reference to your application bearing No. ____ we, WarpDrive Tech Works (hereinafter referred to as "WarpDrive" or "the Company"), inform you that you have been allotted Apartment No. <strong>{!bookingRecord.Unit_Id__r.Name}</strong> on Floor No. <strong>{!bookingRecord.Unit_Id__r.Floor__r.Name}</strong> in multistoried residential apartment building known as <strong>{!bookingRecord.Unit_Id__r.Tower__r.Name}</strong> in &quot;{!bookingRecord.Project__r.Name}&quot; comprising of Carpet area <strong>{!bookingRecord.Unit_Id__r.Carpet_Area__c}</strong> sq.ft., Balcony <strong>{!bookingRecord.Unit_Id__r.Deck_Balcony__c}</strong> sq.ft., Garden Area <strong>{!bookingRecord.Unit_Id__r.Garden_Area__c}</strong> sq.ft., Terrace Area <strong>{!bookingRecord.Unit_Id__r.Terrace_Area__c}</strong> sq.ft., Saleable Area <strong>{!bookingRecord.Unit_Id__r.Saleable_Area__c}</strong> sq.ft., Total area of villa/unit <strong>{!bookingRecord.Unit_Id__r.Total_area_of_villa_unit__c}</strong> sq.ft., along with right to use <strong>{!parkingCount}</strong> nos of car parks etc.
            </p>
            
            <p>The Unit details, other indicative charges, the payment schedule etc. are specified in detail in Schedule I attached to this Allotment Letter.</p>
            <p>The said allotment in your favour shall be subject to your fulfillment of the 'Terms &amp; Conditions' stipulated in the Application Form, this Allotment Letter, Agreement for Sale and other documents that may be required to be executed by you.</p>
        </div>
        <p></p>
        <p></p>
        <!-- Terms & Conditions -->
        <div class="title" style="margin-top: 30px;">TERMS &amp; CONDITIONS</div>
        <ol class="terms-list">
            
            <li>
                The Allottee(s) confirms that prior to seeking this Allotment Letter pertaining to the Unit from the Company, 
                he/she/they have inspected the site where the Project is constructed along with the ownership records and 
                other related documents including but not limited to the title, permissions, sanctions and all other requisite 
                approvals etc., obtained by WarpDrive Tech Works (“the Company”) and hereby acknowledges that 
                the Company has readily provided all information and clarifications as required. The Allottee(s) has/have relied 
                solely on his/her/their personal judgment in deciding to apply for purchase of the Unit. Further, the Allottee(s) 
                is/are satisfied about the title of the Company related to the Project and is also content with the right, title 
                and interest of the Company to sell the Unit and receive the Total Price (as mentioned in Schedule I herein below).
            </li>
            
            <li>
                The Allottee(s) has/have also satisfied himself/herself/themselves in respect of all information, explanations, 
                clarifications, representations (including but not limited to the website/marketing material) solicited by 
                him/her/them regarding the Project, Unit, progress of the Project, amenities, specifications, payment schedule 
                etc., from the representatives of the Company and has/have understood the same and has thereafter sought this 
                Allotment Letter from the Company.
            </li>
            
            <li>
                As indicated at the time of booking, the additional expenses towards external electrification, water &amp; sanitary 
                charges, service charges for property assessment, khata transfer, stamp duty, registration &amp; legal fee etc. will 
                be payable by Allottee(s), on demand at actuals. The Allottee(s) shall be solely liable to pay differential amount 
                due to change in levies, if any, in accordance with statutory norms, regulations etc., from time to time until 
                completion of the Project and the Company shall not be responsible for the same in any manner whatsoever.
            </li>
            
            <li>
                Upon issuance of this Allotment letter, the Allottee(s) shall be solely liable to pay the Total Price and the 
                other indicative charges (as specified in Schedule I) together with the applicable GST and other government levies, 
                along with all milestone payments falling due at prevailing rates in force, which are subject to change from 
                time to time, time being of the essence.
            </li>
            
            <li>
                The Allottee(s) is aware that as per Finance Bill of 2013, TDS is applicable on sale of immovable property wherein 
                the sale consideration exceeds or is equal to Rs. 50,00,000/- (Rupees Fifty Lakhs). The Allottee(s) while making 
                payments shall deduct Tax at rate of 1% of the property cost and the tax so deducted shall be deposited into the 
                Central Government account through any authorized bank branch using the e-Tax payment option available at NSDL. 
                Copies of Form 26QB, TDS Challan and Form 16B shall be handed over to the Company. 
                <br/><br/>
                <strong>Please note Company TDS Details:</strong><br/>
                PAN: AAECP5444J <br/>
                Address: WarpDrive Tech Works,<br/>
                WD HQ 20/22A, 3rd Main, 37th A Cross Rd, 8th Block, Jayanagar, Bengaluru, Karnataka 560070
            </li>
            
            <li>
                The Allottee(s) acknowledges and agrees that the Company at its option is entitled to cancel the allotment of the 
                Unit at any time if payment of any amount due and payable by the Allottee(s) is not made as per this Allotment Letter 
                and/or if the Agreement to Sale of the Unit is not signed and registered within 15 (Fifteen) days from the date of 
                issue of this Allotment Letter. In such an event the Company shall be entitled to forfeit an amount of Rs.25,00,000/-
                (Rupees Twenty-Five Lakhs Only) from and out of the Initial Booking Amount tendered by the Allottee along with the 
                Application Form and the Company shall refund the balance money to the Allottee without any interest. It is further 
                informed, agreed and accepted by the Allottee that, in the event of Allottee opting to cancel the booking of the Unit, 
                at any time before the execution of the Agreement for Sale, the Company shall be entitled to forfeit an amount of 
                Rs.25, 00,000/- (Rupees Twenty-Five Lakhs Only) from and out of the Initial Booking Amount tendered by the Allottee along
                with the Application Form and the Company shall refund the balance money to the Allottee without any interest.
            </li>
            
            <li>
                All payments are to be made by the Allottee(s) within the due dates mentioned in this Allotment Letter. All delayed 
                payments will attract interest at the rate of State Bank of India’s highest marginal cost of lending prevailing at 
                the time of “due date” plus 2% thereon, calculated till the date of payment.
            </li>
            
            <li>
                Tentative building maintenance charges per month calculated for first one year will become payable by the Allottee(s) 
                at actuals on demand. This will be in addition to the maintenance deposit/ corpus fund as indicated in the cost sheet.
            </li>
            
            <li>
                Allotment of the Unit is valid subject to realization of the Initial Booking Amount and submission of duly signed Power of 
                Attorney by the Allottee(s), as the case may be.
            </li>
            
            <li>
                The Company shall endeavour to make available the Unit for possession immediately subject to the Allottee(s) not being in 
                breach of any of the terms of the Application Form/Allotment Letter/Agreement of Sale). In the event if any force majeure 
                situation (including but not limited to inordinate delay in issuance of approvals, NOCs, connections, licenses from the 
                competent local authorities and/or judicial or regulatory orders, the date of such possession shall stand extended accordingly.

            </li>
            
            <li>
                The Allottee(s) agree not to do or omit to do any act, deed or thing or behave inappropriately or correspond or communicate in 
                a manner that would in any manner affect or prejudice or defame the Project, KESSAKU or the Company or its associates or representatives.
                In the event, the Allottee(s) does or omits to do any such act, deed or thing then it shall constitute an event of default and the Company 
                shall be entitled to cancel the allotment of the Unit and forfeit an amount of Rs. 25,00,000/- (Rupees Twenty-Five Lakhs Only) from the Initial
                Booking Amount and shall refund the balance without any interest to the Allottee(s).

            </li>
            
            <li>
                This Allotment Letter shall be governed, interpreted by and construed in accordance with the Laws of India. The Courts at Bengaluru alone shall
                have exclusive jurisdiction over all matters arising out of or relating to this Letter of Allotment.
            </li>
            
            <li>
                The Allottee(s) confirm that the terms and conditions as stated in the Application Form and this Allotment Letter are understood and duly accepted
                by the Allottee(s) and he/she/they have agreed to strictly abide by the same.
            </li>
            
        </ol>
        
        
        <!-- CRM Contact -->
        <div class="section">
            <p><strong>Please ensure to strictly comply with the terms of this Allotment. Our Customer Relationship Management team can be contacted for any queries or assistance:</strong></p>
            <p>Board Line: 080-33580700</p>
            <p>Email: crm.bangalore@phoenixmills.com</p>
        </div>
        <!-- Signature Section -->
        <p>Thank you for choosing WarpDrive Tech Works.</p>
        <p>We assure you our best services as always.</p>
        <p>Yours Sincerely,</p>
        <p>For WarpDrive Tech Works</p>
        <p style="margin-top:40px;">______________________________</p>
        <p>Authorised Signatory.</p>
        <!-- Acceptance Section -->
        <p style="margin-top:50px; border-top:1px solid #ccc; padding-top:20px;">
            We hereby accept the allotment and terms contained herein:
        </p>
        <p style="margin-top:40px;">______________________________</p>
        <p>Date: <strong>{!DAY(TODAY())}/{!MONTH(TODAY())}/{!YEAR(TODAY())}</strong></p>
        <p>Place: Bengaluru</p>
        <p></p>
        <p></p>
        
        <!--<div class="page-break">&nbsp;</div>-->
        
        <!-- Schedule I -->
        <div class="schedule-title">Schedule I</div>
        
        <h3 style="font-weight: bold;">Unit Details</h3>
        <table class="schedule-table">
            <tr><td>Project</td><td><strong>{!bookingRecord.Project__r.Name}</strong></td></tr>
            <tr><td>Block</td><td><strong>{!bookingRecord.Unit_Id__r.Tower__r.Name}</strong></td></tr>
            <tr><td>Unit no.</td><td><strong>{!bookingRecord.Unit_Id__r.Name}</strong></td></tr>
            <tr><td>Unit type</td><td><strong>{!bookingRecord.Unit_Id__r.BHK_Configuration__c}</strong></td></tr>
            <tr><td>RERA Carpet Area of the unit(Sq.ft)</td><td><strong>{!bookingRecord.Unit_Id__r.Carpet_Area__c}</strong></td></tr>
            <tr><td>Right to use Car Parks(nos.)</td><td><strong>{!parkingCount}</strong></td></tr>
            <tr><td>Base cost</td><td><strong>Rs.{!bookingRecord.Opportunity_Id__r.Base_Cost__c}</strong></td></tr>
            <tr><td>Total flat cost (Including other indicative charges)</td><td><strong>Rs. {!bookingRecord.Opportunity_Id__r.Total_Amount__c}/-</strong></td></tr>
        </table>
        
        <!-- Other Indicative Charges -->
        <h3 style="font-weight: bold; margin-top: 20px;">Other Indicative Charges</h3>
        <table class="schedule-table">
            <thead>
                <tr><th>Charge Types</th><th>Amount (Rs.)</th></tr>
            </thead>
            <tbody>
                <tr><td>Club Membership Fee</td><td><strong>Rs. <apex:outputText value="{0, number, ###,###,##0.00}"><apex:param value="{!clubBasic}" /></apex:outputText></strong></td></tr>
                <tr><td>BESCOM &amp; BWSSB Charges</td><td><strong>Rs. <apex:outputText value="{0, number, ###,###,##0.00}"><apex:param value="{!bescomBasic}" /></apex:outputText></strong></td></tr>
                <tr><td>Maintenance Deposit</td><td><strong>Rs. <apex:outputText value="{0, number, ###,###,##0.00}"><apex:param value="{!maintenanceBasic}" /></apex:outputText></strong></td></tr>
                <tr><td>Legal Fees</td><td><strong>Rs. <apex:outputText value="{0, number, ###,###,##0.00}"><apex:param value="{!legalBasic}" /></apex:outputText></strong></td></tr>
                <tr><td>CGST-CGST 9% Others</td><td><strong>Rs. <apex:outputText value="{0, number, ###,###,##0.00}"><apex:param value="{!cgstAmount}" /></apex:outputText></strong></td></tr>
                <tr><td>SGST-SGST 9% Others</td><td><strong>Rs. <apex:outputText value="{0, number, ###,###,##0.00}"><apex:param value="{!sgstAmount}" /></apex:outputText></strong></td></tr>
                <tr><td><strong>Total</strong></td><td><strong>Rs. <apex:outputText value="{0, number, ###,###,##0.00}"><apex:param value="{!totalOtherAmount}" /></apex:outputText></strong></td></tr>
            </tbody>
        </table>
        
        <!-- Notes -->
        <div class="section" style="margin-top: 30px;">
            <p><strong>Note:</strong></p>
            <ul class="note-list" style="padding-left: 15px;">
                <li>Cheques are to be drawn in favour of “WarpDrive Tech Works”</li>
                <li>C-GST is calculated at 9% on Club House Charges, BESCOM &amp; BWSSB Charges, and Legal Fees. The aforesaid rate of percentage of CGST is subject to changes in the Goods and Service Tax Act.</li>
                <li>S-GST is calculated at 9% on Club House Charges, BESCOM &amp; BWSSB Charges, and Legal Fees. The aforesaid rate of percentage of CGST is subject to changes in the Goods and Service Tax Act.</li>
                <li>Any other taxes, duties levied shall be charged extra as per prevailing norms. In addition, registration fees and stamp duty shall be charged at the rate prevailing at the time of the registration of the flat.</li>
                <li>0.5% of the Agreement value to be paid at the time of executing the Agreement to Sell directly to the Karnataka Treasury through your bank.</li>
                <li>Indicative CAM Charges of “Kessaku” is Rs. 6.35 plus applicable taxes/month on aggregate area is payable from the date of intimation of possession for the respective Financial Year.</li>
                <li>Indicative CAM Charges of “Schedule A” is Rs. 0.77 plus applicable taxes/month on aggregate area is payable from the date of intimation of possession for the respective Financial Year.</li>
                <li>Rs. 4500/- per month plus applicable tax is payable extra towards Kessaku Club  Maintenance Charges and Rs 1200/- per month plus applicable tax is payable towards Club One Maintenance Charges from the date of intimation of possession for the respective Financial Year.</li>
            </ul>
        </div>
        <p></p>
        <!-- Payment Schedule -->
        <h3 style="font-weight: bold; margin-top: 20px;">Payment Schedule</h3>
        <table class="schedule-table">
            <thead>
                <tr>
                    <th>SI.No</th>
                    <th>Payment Event</th>
                    <th>Amount (Rs.)</th>
                </tr>
            </thead>
            <tbody>
                <apex:repeat var="detail" value="{!bookingPaymentSchedulesList}">
                    <tr>
                        <td>{!detail.Installment_Number__c}</td>
                        <td>{!detail.Milestone_Code__c}</td>
                        <td>Rs. {!detail.Installment_Amount__c}</td>
                    </tr>
                </apex:repeat>
                
                <!-- Total Row -->
                <tr style="font-weight:bold; border-top:1px solid #000;">
                    <td colspan="2" style="text-align:right;">Total</td>
                    <td>Rs. {!bookingPaymentSchedulesTotal}</td>
                </tr>
            </tbody>
        </table>
        
    </body>
</apex:page>