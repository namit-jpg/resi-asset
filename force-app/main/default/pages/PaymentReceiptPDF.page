    <!-- ===== Company header box ===== -->
    <table class="box mt16" border="1">
        <tr>
            <td class="title" colspan="2">
                <img src="{!$Resource.WD_Doc_Logo}" alt="WarpDrive Tech Works" style="height:12mm;"/><br/>
                WarpDrive Tech Works<br/>
                No. 1, Dr. Rajkumar Road, Opp. Sheraton Hotel, Rajajinagar, Bangalore 560 010
            </td>
        </tr>
        <tr>
            <td colspan="2">
                <table style="width:100%; table-layout:fixed;">
                    <colgroup><col width="50%"/><col width="50%"/></colgroup>
                    <tr>
                        <td>Receipt No: <span class="u u150">{!Payment_Receipt__c.SAP_External_Id__c}</span></td>
                        <td class="right">Date:
                            <span class="u u120">
                                <apex:outputText value="{0,date,dd-MM-yyyy}">
                                    <apex:param value="{!Payment_Receipt__c.CreatedDate}"/>
                                </apex:outputText>
                            </span>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
        
        <!-- thin rule to match the sample -->
    
        <tr>
            <td colspan="2" style="border-bottom:none">

    <!-- ===== Body (sentences with inline underlines) ===== -->
    			<div class="mt12">
                    <p class="mt8">Received with thanks from {!Payment_Receipt__c.Account__r.Salutation}
                        <span class="u u280">{!Payment_Receipt__c.Account__r.Name}</span>
                    </p>
                    
                    <p class="mt8">The sum of <span>Rupees:</span>
                        <span class="u u280">{!AmountInWords}</span>
                        <span >Only</span>
                    </p>
                    
                    <p class="mt8">
                        by
                        <!-- PAYMENT MODE SWITCH -->
                        <apex:outputPanel rendered="{!Payment_Receipt__c.Mode_Of_Payment__c = 'TDS'}">
                            Cheque /DD.No./RTGS No.
                            <span class="u u120">Challan: {!Payment_Receipt__c.Challan_Number__c}</span>
                            <span class="u u120">Cert: {!Payment_Receipt__c.Certificate_Number__c}</span>
                        </apex:outputPanel>
                        <apex:outputPanel rendered="{!Payment_Receipt__c.Mode_Of_Payment__c = 'Cheque'}">
                            Cheque /DD.No./RTGS No. <span class="u u180">Cheque No: {!Payment_Receipt__c.ChequeNumber__c}</span>
                        </apex:outputPanel>
                        <apex:outputPanel rendered="{!AND(Payment_Receipt__c.Mode_Of_Payment__c <> 'TDS',
                                                    Payment_Receipt__c.Mode_Of_Payment__c <> 'Cheque')}">
                            Cheque /DD.No./RTGS No. <span class="u u180">{!Payment_Receipt__c.Transaction_Reference__c}</span>
                        </apex:outputPanel>
                    </p>
                    
                    <p class="mt8">Dated:
                        <span class="u u120">
                            <apex:outputText value="{0,date,dd-MM-yyyy}">
                                <apex:param value="{!Payment_Receipt__c.Date_Of_Payment__c}"/>
                            </apex:outputText>
                        </span>
                    </p>
                    
                    <p class="mt8">Drawn on:
                        <span class="u u180">{!Payment_Receipt__c.Customer_Bank_Name__c}</span>
                        <!--<span >BANK</span>-->
                    </p>
                    
                    <p class="mt8">towards the Flat No.
                        <span class="u u90">{!Payment_Receipt__c.Demand__r.Booking_Id__r.Unit_Id__r.Name}</span>
                        in "{!Payment_Receipt__c.Demand__r.Booking_Id__r.Unit_Id__r.Property__r.Name}"
                    </p>
                </div>
            </td>
        </tr>

    <!-- ===== Bottom two boxes row ===== -->
        <tr >
            <td style="border-right:none;border-top:none;border-bottom:none;">
                <div class="amountBox pad8">
                    Rs. <apex:outputText value="{0, number, ###,##,##0.00}">
                            <apex:param value="{!Payment_Receipt__c.Amount_Paid__c}"/>
                        </apex:outputText> /-
                </div>
            </td>
            <td class="right" style="border-left:none;border-top:none;border-bottom:none;">
                <div class="signBox pad8">&nbsp;</div>
            </td>
        </tr>
        <tr>
        	<td class="right mt12" colspan="2" style="border-top:none;padding-right:90px">Authorized Signatory</td>
        </tr>
    </table>

    <div class="small ital note">
        * Validity of receipt is subject to realization of above mentioned instrument/s
    </div>
</apex:page>