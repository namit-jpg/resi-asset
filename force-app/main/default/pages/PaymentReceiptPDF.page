<apex:page showHeader="false" applyHtmlTag="false" standardStylesheets="false"
            standardController="Payment_Receipt__c" renderAs="pdf"
           extensions="PaymentReceiptPDFExt"
           contentType="application/pdf#Payment Receipt - {!Payment_Receipt__c.SAP_External_Id__c}.pdf"
           >

<head>
    
        <style type="text/css">
        @page { size: A4; margin: 16mm; }
        body, td, th { font-family: Arial, Helvetica, sans-serif; font-size: 12pt; line-height: 1.35; color:#000; }
        table { border-collapse: collapse; width: 100%; table-layout: fixed; }
        .center { text-align: center; } .right { text-align: right; } .bold { font-weight: bold; }
        .small { font-size: 10pt; } .ital { font-style: italic; }
        .mt8 { margin-top:8px; } .mt12{ margin-top:12px; } .mt16{ margin-top:16px; } .mb8{ margin-bottom:8px; }
        .pad6{ padding:6px; } .pad8{ padding:8px; }

        /* underline blanks as inline blocks (works well inside single TD) */
        .u { display:inline-block; border-bottom:1px solid #000; padding:0 2px; vertical-align:baseline; }
        .u90{ width:90px; } .u120{ width:120px; } .u150{ width:150px; }
        .u180{ width:180px; } .u220{ width:220px; } .u280{ width:280px; } .u320{ width:320px; }

        /* header “box” with top title + address; then a row for receipt/date */
        .box { border:1px solid #000; }
        .box .title { background:#eee; font-weight:bold; text-align:center; padding:8px 6px; }
        .box td { padding:8px 6px; vertical-align:middle; }
        .box td.borderTop { border-top:1px solid #000; }

        /* thin horizontal rule below header details */
        .hr { border-top:1px solid #000; height:0; margin:0; }

        /* bottom two small boxes */
        .amountBox, .signBox { border:1px solid #000; height:36px; }
        .note { margin-top:10px; }

        /* top recipient block spacing */
        .recip td { padding: 3px 0; }
    </style>
</head>
    
    
    <p>
        <strong> {!Payment_Receipt__c.Account__r.Salutation}{!Payment_Receipt__c.Account__r.Name}</strong> <br/>
       
         {!Payment_Receipt__c.Account__r.PersonMailingStreet}<br/>
         {!Payment_Receipt__c.Account__r.PersonMailingCity},
         {!Payment_Receipt__c.Account__r.PersonMailingPostalCode}<br/>
         Ph No: {!Payment_Receipt__c.Account__r.Phone}
   		
    </p>
    <!-- ===== Recipient block (top left) ===== -->
