            <td><span class="u320">
                {!Payment_Receipt__c.Demand__r.Booking_Id__r.Account_Id__r.PersonMailingCity},
                {!Payment_Receipt__c.Demand__r.Booking_Id__r.Account_Id__r.PersonMailingPostalCode}
