<apex:page standardController="Unit__c" extensions="SalesOfferController" renderAs="PDF" applyHtmlTag="false" standardStylesheets="false" showHeader="false" sidebar="false">
    <head>
        <style type="text/css" media="print">
            /* CSS for PDF styling */
            body {
                font-family: Arial, sans-serif;
                margin: 0.5in;
                font-size: 10pt;
            }
            .header {
                text-align: center;
                font-size: 24px;
                font-weight: bold;
                margin-bottom: 5px;
            }
            .sub-header {
                text-align: center;
                font-size: 12px;
                margin-bottom: 20px;
            }
            .table-section {
                margin-top: 20px;
                border-collapse: collapse;
                width: 100%;
            }
            .table-section th, .table-section td {
                border: 1px solid #000;
                padding: 6px;
                text-align: center;
                font-size: 11px;
            }
            .table-section th {
                background-color: #d3d3d3;
            }
            .highlight-row {
                font-weight: bold;
                background-color: #e6f0ff;
            }
            .total-row {
                font-weight: bold;
                background-color: #cce5ff;
            }
            .note-section, .definition-section, .tax-section {
                font-size: 10px;
                margin-top: 20px;
                line-height: 1.4em;
            }
            .note-section ul, .definition-section ul, .tax-section ul {
                padding-left: 18px;
            }
        </style>
    </head>

    <body>
        <div style="text-align:center; margin-bottom:6px;"><img src="{!$Resource.WD_Doc_Logo}" alt="WarpDrive Tech Works" style="height:12mm;"/></div>
        <div class="header">{!unitDetails.Property__r.Name}</div>
        <div class="sub-header">{!unitDetails.Property__r.Address__c}<br/>CIN: {!unitDetails.Property__r.CIN__c} | GSTIN: {!unitDetails.Property__r.GSTIN__c}</div>

        <table class="table-section">
            <tr><th colspan="9">Price Sheet</th></tr>
            <tr>
                <th>Project</th><th>Unit Number #</th><th>Floor</th><th>Type</th>
                <th>SBA (Sft)</th><th>RERA Carpet Area (Sft)</th><th>Deck/Balcony (Sft)</th>
                <th>Private Lobby (Sft)</th><th>Garden Area (Sft)</th>
            </tr>
            <tr>
                <td>{!unitDetails.Property__r.Name}</td>
                <td>{!unitDetails.Name}</td>
                <td>{!unitDetails.Floor__r.Name}</td>
                <td>{!unitDetails.Unit_Type__c}</td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!unitDetails.Built_Up_Area_SBA__c}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!unitDetails.Carpet_Area__c}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!unitDetails.Deck_Balcony__c}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!unitDetails.Private_Lobby__c}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!unitDetails.Garden_Area__c}"/></apex:outputText></td>
            </tr>
            <tr class="highlight-row">
                <td colspan="4"></td>
                <td colspan="2">Sale Price</td><td>GST (12%)</td><td colspan="2">Total Sale Price</td>
            </tr>
            <tr>
                <td colspan="4">Land Charges</td>
                
                <td colspan="2"><apex:outputText value="{0,number,##0.00}"><apex:param value="{!landCharges}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!gstAmountOnLandCharges}"/></apex:outputText></td>
                <td colspan="2"><apex:outputText value="{0,number,##0.00}"><apex:param value="{!landChargesTotal}"/></apex:outputText></td>
            </tr>
            <tr>
                <td colspan="4">Construction Charges</td>
                
                <td colspan="2"><apex:outputText value="{0,number,##0.00}"><apex:param value="{!constructionCharges}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!gstAmountOnConstCharges}"/></apex:outputText></td>
                <td colspan="2"><apex:outputText value="{0,number,##0.00}"><apex:param value="{!constructionChargesTotal}"/></apex:outputText></td>
            </tr>
            <tr class="total-row">
                <td colspan="9">Total Base Cost (Rs.) - A: <apex:outputText value="{0,number,##0.00}"><apex:param value="{!grandTotal}"/></apex:outputText></td>
            </tr>
        </table>
        
         <table class="table-section">
            <tr style="font-weight:bold; background:#d3d3d3; text-align:center; border:1px solid #000; border-top:none; padding:6px;"><th colspan="9">Indicative Other Charges</th></tr>
            <tr>
                <th></th>
                <th>Basic Cost</th>
                <th>GST (18%)</th>
                <th>Total</th>
            </tr>
            <tr>
                <td>BESCOM &amp; BWSSB Charges</td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!bescomBasic}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!bescomGST}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!bescomTotal}"/></apex:outputText></td>
            </tr>
            <tr>
                <td>Maintenance Deposit/Corpus Fund</td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!maintenanceBasic}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!maintenanceGST}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!maintenanceTotal}"/></apex:outputText></td>
            </tr>
            <tr>
                <td>Club Membership Fee</td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!clubBasic}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!clubGST}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!clubTotal}"/></apex:outputText></td>
            </tr>
            <tr>
                <td>Legal Fees</td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!legalBasic}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!legalGST}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!legalTotal}"/></apex:outputText></td>
            </tr>
            <tr class="total-row">
                <td>Total (Rs.) - B</td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!otherChargesTotalBasic}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!otherChargesTotalGST}"/></apex:outputText></td>
                <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!otherChargesTotal}"/></apex:outputText></td>
            </tr>
            <tr class="total-row">
                <td colspan="4">Grand Total (A + B): <apex:outputText value="{0,number,##0.00}"><apex:param value="{!grandTotalWithOtherCharges}"/></apex:outputText></td>
            </tr>
        </table>
        
        
       
        <table class="table-section">
        <tr style="font-weight:bold; background:#d3d3d3; text-align:center; border:1px solid #000; border-top:none; padding:6px;"><th colspan="9">Payment Schedule</th></tr>

        <tr>
            <th>Name</th> <th>Installment Percentage (%)</th>
            <th>Installment Amount</th>
            <th>GST</th>
            <th>Total</th>
        </tr>

        <apex:repeat var="detail" value="{!paymentPlanDetailList}">
    <tr>
        <td>{!detail.Name}</td>
        
        <td>
            <apex:outputText value="{0,number,##0.00}">
                <apex:param value="{!detail.Payment_Percentage__c}"/>
            </apex:outputText>
        </td>
        
         <!-- Installment Amount (excluding GST) -->
        <td>
            <apex:outputText value="{0,number,##0.00}">
                <apex:param value="{!
                    ROUND(((detail.Payment_Percentage__c * grandTotalWithOtherCharges) / 100), 2) -
                    ROUND((combinedGST)/countOfPaymentSchedule, 2)
                }"/>
            </apex:outputText>
        </td>
        
        <!-- GST (assuming 18%) -->
        <td>
            <apex:outputText value="{0,number,##0.00}">
                <apex:param value="{!ROUND((combinedGST)/countOfPaymentSchedule, 2)}"/>
            </apex:outputText>
        </td>
        
        <!-- Total -->
        <td>
            <apex:outputText value="{0,number,##0.00}">
                <apex:param value="{!
                                   (
                                   ROUND(((detail.Payment_Percentage__c * grandTotalWithOtherCharges) / 100), 2) -
                                   ROUND((combinedGST)/countOfPaymentSchedule, 2)
                                   )
                                   +
                                   ROUND((combinedGST)/countOfPaymentSchedule, 2)
                                   }"/>
            </apex:outputText>
        </td>

    </tr>
</apex:repeat>

        <tr class="total-row">
            <td>Total</td>
            <td>100%</td>
            <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!installmentAmountTotal}"/></apex:outputText></td>
            <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!tableGSTTotal}"/></apex:outputText></td>
            <td><apex:outputText value="{0,number,##0.00}"><apex:param value="{!tableGrandTotalWithGST}"/></apex:outputText></td>
        </tr>
    </table>


<div class="tax-section">
    <p><strong>Disclaimer:</strong> Any prices, unit numbers or availability indicated does not constitute an offer for sale made by the company. Prices are subject to change at the sole discretion of the company and the company may refuse to sell any unit without assigning reason for the same.</p>
</div>
    </body>
</apex:page>