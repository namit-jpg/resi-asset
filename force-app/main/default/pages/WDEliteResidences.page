<apex:page showHeader="false" sidebar="false" standardStylesheets="false" applyHtmlTag="false" applyBodyTag="false" docType="html-5.0" cache="false">
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>WD Elite Residences | Luxury Homes in Bengaluru, Hyderabad &amp; Gurugram</title>
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600;700&amp;family=Inter:wght@400;500;600&amp;display=swap" />
<style>
:root{
  --ink:#14161c; --ink-2:#3a3f4b; --muted:#6b7080;
  --cream:#f7f3ec; --paper:#ffffff; --line:#e6e0d4;
  --gold:#b08d57; --gold-2:#8a6a3b; --navy:#10182b;
  --radius:14px;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Inter,system-ui,sans-serif;color:var(--ink);background:var(--cream);line-height:1.6;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
img{display:block;max-width:100%}
.wrap{max-width:1180px;margin:0 auto;padding:0 24px}
h1,h2,h3{font-family:"Cormorant Garamond",Georgia,serif;font-weight:600;line-height:1.1;letter-spacing:-.01em}
.eyebrow{font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--gold);font-weight:600}

/* nav */
.nav{position:fixed;inset:0 0 auto 0;z-index:50;transition:background .3s,box-shadow .3s}
.nav.solid{background:rgba(16,24,43,.96);box-shadow:0 2px 18px rgba(0,0,0,.18)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:76px}
.brand{display:flex;align-items:center;gap:12px;color:#fff}
.brand-mark{width:38px;height:38px;border:1.5px solid var(--gold);display:grid;place-items:center;font-family:"Cormorant Garamond",serif;font-size:18px;color:var(--gold);font-weight:700}
.brand-name{font-family:"Cormorant Garamond",serif;font-size:22px;font-weight:600;letter-spacing:.04em}
.brand-name small{display:block;font-family:Inter,sans-serif;font-size:10px;letter-spacing:.3em;color:#cfc6b4;font-weight:500}
.links{display:flex;gap:32px;align-items:center}
.links a{color:#e9e4da;font-size:14px;font-weight:500}
.links a:hover{color:#fff}
.btn{display:inline-flex;align-items:center;gap:10px;border:0;cursor:pointer;font:600 14px Inter,sans-serif;padding:14px 26px;border-radius:999px;transition:transform .15s,background .2s,box-shadow .2s}
.btn:hover{transform:translateY(-1px)}
.btn-gold{background:var(--gold);color:#fff;box-shadow:0 8px 24px rgba(176,141,87,.35)}
.btn-gold:hover{background:var(--gold-2)}
.btn-ghost{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.35);backdrop-filter:blur(4px)}
.btn-ghost:hover{background:rgba(255,255,255,.2)}
.btn-dark{background:var(--navy);color:#fff}
.btn-sm{padding:10px 18px;font-size:13px}

/* hero */
.hero{position:relative;min-height:100vh;display:flex;align-items:flex-end;color:#fff;
  background:linear-gradient(180deg,rgba(10,14,26,.55) 0%,rgba(10,14,26,.25) 40%,rgba(10,14,26,.85) 100%),
  url("https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?w=2000&amp;q=80") center/cover no-repeat}
.hero .wrap{padding-bottom:96px;padding-top:140px;width:100%}
.hero h1{font-size:clamp(44px,7vw,88px);max-width:820px;margin:18px 0 22px}
.hero p{font-size:18px;max-width:560px;color:#ece6da}
.hero-cta{display:flex;gap:14px;margin-top:36px;flex-wrap:wrap}
.hero-stats{display:flex;gap:56px;margin-top:64px;padding-top:28px;border-top:1px solid rgba(255,255,255,.2);flex-wrap:wrap}
.hero-stats b{display:block;font-family:"Cormorant Garamond",serif;font-size:40px;font-weight:600;color:#fff}
.hero-stats span{font-size:13px;color:#d6cfc1;letter-spacing:.04em}

/* sections */
section{padding:110px 0}
.head{display:flex;justify-content:space-between;align-items:flex-end;gap:32px;margin-bottom:52px;flex-wrap:wrap}
.head h2{font-size:clamp(34px,4.5vw,54px);margin-top:12px;max-width:640px}
.head p{max-width:420px;color:var(--muted)}

/* city tabs + projects */
.tabs{display:flex;gap:10px;margin-bottom:34px;flex-wrap:wrap}
.tab{border:1px solid var(--line);background:var(--paper);padding:10px 20px;border-radius:999px;font:500 14px Inter,sans-serif;cursor:pointer;color:var(--ink-2)}
.tab.on{background:var(--navy);color:#fff;border-color:var(--navy)}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
.card{background:var(--paper);border-radius:var(--radius);overflow:hidden;border:1px solid var(--line);transition:transform .25s,box-shadow .25s;display:flex;flex-direction:column}
.card:hover{transform:translateY(-4px);box-shadow:0 22px 44px rgba(20,22,28,.1)}
.card .img{aspect-ratio:4/3;background-size:cover;background-position:center;position:relative}
.card .tag{position:absolute;top:16px;left:16px;background:rgba(16,24,43,.85);color:#fff;font-size:11px;letter-spacing:.14em;text-transform:uppercase;padding:6px 12px;border-radius:999px}
.card .body{padding:24px 24px 26px;display:flex;flex-direction:column;gap:8px;flex:1}
.card h3{font-size:28px}
.card .loc{font-size:13px;color:var(--muted);display:flex;align-items:center;gap:6px}
.card .meta{display:flex;gap:18px;font-size:13px;color:var(--ink-2);margin:10px 0 18px;padding-top:14px;border-top:1px solid var(--line)}
.card .actions{margin-top:auto;display:flex;gap:10px}
.card.hide{display:none}

/* amenities */
.amen{background:var(--navy);color:#fff}
.amen .head p{color:#b9b3a6}
.amen-grid{display:grid;grid-template-columns:1.1fr 1fr;gap:56px;align-items:center}
.amen-img{border-radius:var(--radius);aspect-ratio:5/4;background:url("https://images.unsplash.com/photo-1600607687939-ce8a6c25118c?w=1400&amp;q=80") center/cover}
.amen-list{display:grid;grid-template-columns:1fr 1fr;gap:28px 32px}
.amen-list div{border-top:1px solid rgba(255,255,255,.14);padding-top:18px}
.amen-list h4{font:600 15px Inter,sans-serif;margin-bottom:6px;color:#fff}
.amen-list p{font-size:14px;color:#b9b3a6}

/* concierge */
.concierge-box{background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:56px;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.concierge-box h2{font-size:clamp(32px,4vw,48px);margin:12px 0 16px}
.concierge-box p{color:var(--muted)}
.prompts{display:flex;flex-direction:column;gap:12px}
.prompt{display:flex;justify-content:space-between;align-items:center;gap:16px;text-align:left;width:100%;background:var(--cream);border:1px solid var(--line);border-radius:12px;padding:16px 20px;font:500 15px Inter,sans-serif;color:var(--ink);cursor:pointer;transition:border-color .2s,background .2s}
.prompt:hover{border-color:var(--gold);background:#fff}
.prompt span.arrow{color:var(--gold);font-size:18px}
.hint{font-size:12px;color:var(--muted);margin-top:14px}

/* footer */
footer{background:#0b1120;color:#a9a393;padding:64px 0 36px;font-size:14px}
.foot{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:40px;padding-bottom:40px;border-bottom:1px solid rgba(255,255,255,.08)}
.foot h5{color:#fff;font:600 13px Inter,sans-serif;letter-spacing:.14em;text-transform:uppercase;margin-bottom:16px}
.foot li{list-style:none;margin-bottom:8px}
.copy{padding-top:26px;display:flex;justify-content:space-between;flex-wrap:wrap;gap:12px;font-size:12px}

/* toast */
.toast{position:fixed;left:50%;bottom:28px;transform:translateX(-50%) translateY(20px);opacity:0;background:var(--navy);color:#fff;padding:12px 20px;border-radius:999px;font-size:13px;transition:all .3s;z-index:60;pointer-events:none}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}

@media (max-width:960px){
  .grid{grid-template-columns:1fr 1fr}
  .amen-grid,.concierge-box{grid-template-columns:1fr}
  .concierge-box{padding:36px 28px}
  .foot{grid-template-columns:1fr 1fr}
  .links a:not(.btn){display:none}
}
@media (max-width:620px){
  .wrap{padding:0 16px}
  .grid,.amen-list{grid-template-columns:1fr}
  section{padding:76px 0}
  .hero-stats{gap:28px}
  .hero .wrap{padding-bottom:64px}
  .links .btn{display:none}
}
</style>
</head>
<body>

<header class="nav" id="nav">
  <div class="wrap">
    <a href="#top" class="brand">
      <div class="brand-mark">WD</div>
      <div class="brand-name">WD Elite<small>RESIDENCES</small></div>
    </a>
    <nav class="links">
      <a href="#projects">Projects</a>
      <a href="#amenities">Lifestyle</a>
      <a href="#concierge">Concierge</a>
      <button class="btn btn-gold btn-sm" type="button" onclick="openChat()">Talk to our concierge</button>
    </nav>
  </div>
</header>

<main id="top">
  <section class="hero">
    <div class="wrap">
      <div class="eyebrow">Bengaluru &#183; Hyderabad &#183; Gurugram</div>
      <h1>Homes crafted for the way you want to live.</h1>
      <p>Six signature residential communities across India's fastest-growing cities. Explore floor plans, amenities and neighbourhoods, then book a private site visit in minutes.</p>
      <div class="hero-cta">
        <button class="btn btn-gold" type="button" onclick="openChat()">Chat with our AI concierge &#8594;</button>
        <a class="btn btn-ghost" href="#projects">Explore projects</a>
      </div>
      <div class="hero-stats">
        <div><b>6</b><span>Residential projects</span></div>
        <div><b>3</b><span>Cities</span></div>
        <div><b>24/7</b><span>Concierge assistance</span></div>
      </div>
    </div>
  </section>

  <section id="projects">
    <div class="wrap">
      <div class="head">
        <div>
          <div class="eyebrow">Our communities</div>
          <h2>Find the address that fits your next chapter.</h2>
        </div>
        <p>Every community shares the WD Elite standard: generous open spaces, resort-style amenities and homes built to a standard you can feel the moment you walk in.</p>
      </div>

      <div class="tabs" role="tablist">
        <button class="tab on" type="button" data-city="all">All cities</button>
        <button class="tab" type="button" data-city="Bengaluru">Bengaluru</button>
        <button class="tab" type="button" data-city="Hyderabad">Hyderabad</button>
        <button class="tab" type="button" data-city="Gurugram">Gurugram</button>
      </div>

      <div class="grid" id="grid"></div>
    </div>
  </section>

  <section class="amen" id="amenities">
    <div class="wrap">
      <div class="head">
        <div>
          <div class="eyebrow">Lifestyle</div>
          <h2>Amenities designed around you.</h2>
        </div>
        <p>From the clubhouse to the smallest fixture, each detail is chosen for comfort, wellbeing and a sense of arrival.</p>
      </div>
      <div class="amen-grid">
        <div class="amen-img" role="img" aria-label="Residence interior"></div>
        <div class="amen-list">
          <div><h4>Clubhouse &amp; lounge</h4><p>Resident-only spaces for work, leisure and hosting.</p></div>
          <div><h4>Infinity pool</h4><p>Temperature-controlled pool with a sun deck.</p></div>
          <div><h4>Wellness studio</h4><p>Gym, yoga pavilion and spa treatment rooms.</p></div>
          <div><h4>Landscaped greens</h4><p>Walking trails, play zones and pet-friendly lawns.</p></div>
          <div><h4>Smart homes</h4><p>App-controlled lighting, access and security.</p></div>
          <div><h4>Connected locations</h4><p>Close to business districts, schools and hospitals.</p></div>
        </div>
      </div>
    </div>
  </section>

  <section id="concierge">
    <div class="wrap">
      <div class="concierge-box">
        <div>
          <div class="eyebrow">AI concierge</div>
          <h2>Ask anything. Book a visit in one conversation.</h2>
          <p>Our concierge knows every project, floor plan and neighbourhood. It can send you a brochure, answer questions about amenities and connectivity, and schedule a site visit at a time that suits you.</p>
          <div style="margin-top:28px"><button class="btn btn-dark" type="button" onclick="openChat()">Start a conversation &#8594;</button></div>
        </div>
        <div>
          <div class="prompts">
            <button class="prompt" type="button" onclick="askChat(this)"><span>Which cities do you have projects in?</span><span class="arrow">&#8594;</span></button>
            <button class="prompt" type="button" onclick="askChat(this)"><span>Show me projects in Bengaluru</span><span class="arrow">&#8594;</span></button>
            <button class="prompt" type="button" onclick="askChat(this)"><span>What amenities does Nikoo Homes have?</span><span class="arrow">&#8594;</span></button>
            <button class="prompt" type="button" onclick="askChat(this)"><span>Please send me the brochure</span><span class="arrow">&#8594;</span></button>
            <button class="prompt" type="button" onclick="askChat(this)"><span>I'd like to book a site visit this weekend</span><span class="arrow">&#8594;</span></button>
          </div>
          <div class="hint">Tap a question to copy it, then paste it into the chat.</div>
        </div>
      </div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap">
    <div class="foot">
      <div>
        <div class="brand" style="margin-bottom:14px"><div class="brand-mark">WD</div><div class="brand-name">WD Elite<small>RESIDENCES</small></div></div>
        <p style="max-width:320px">A WarpDrive Tech Works development. Luxury residential communities in Bengaluru, Hyderabad and Gurugram.</p>
      </div>
      <div><h5>Bengaluru</h5><ul><li>Nikoo Homes</li><li>Varthur Vista</li><li>Yalahanka Yard</li></ul></div>
      <div><h5>Hyderabad</h5><ul><li>Banjara Beam</li><li>Miyapur Manor</li></ul></div>
      <div><h5>Gurugram</h5><ul><li>Saket Square</li></ul></div>
    </div>
    <div class="copy"><span>&#169; 2026 WD Elite Residences. All rights reserved.</span><span>Images are for representation only. *Indicative starting price; varies by project, tower and floor.</span></div>
  </div>
</footer>

<div class="toast" id="toast"></div>

<script type="text/javascript">
//<![CDATA[
var PROJECTS = [
  {name:"Nikoo Homes",   city:"Bengaluru", type:"1-4 BHK, duplexes & penthouses", size:"From ₹1.85 Cr*", img:"photo-1545324418-cc1a3fa10c00", tag:"WD Elite"},
  {name:"Varthur Vista", city:"Bengaluru", type:"1-4 BHK, duplexes & penthouses", size:"From ₹1.85 Cr*", img:"photo-1600585154340-be6161a56a0c", tag:"WD Elite"},
  {name:"Yalahanka Yard",city:"Bengaluru", type:"1-4 BHK, duplexes & penthouses", size:"From ₹1.85 Cr*", img:"photo-1600566753190-17f0baa2a6c3", tag:"WD Elite"},
  {name:"Banjara Beam",  city:"Hyderabad", type:"1-4 BHK, duplexes & penthouses", size:"From ₹1.85 Cr*", img:"photo-1512917774080-9991f1c4c750", tag:"WD Elite"},
  {name:"Miyapur Manor", city:"Hyderabad", type:"1-4 BHK, duplexes & penthouses", size:"From ₹1.85 Cr*", img:"photo-1600607687939-ce8a6c25118c", tag:"WD Elite"},
  {name:"Saket Square",  city:"Gurugram",  type:"1-4 BHK, duplexes & penthouses", size:"From ₹1.85 Cr*", img:"photo-1600596542815-ffad4c1539a9", tag:"WD Elite"}
];

function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c];});}

function renderProjects(){
  var html = "";
  for (var i = 0; i < PROJECTS.length; i++){
    var p = PROJECTS[i];
    html += '<article class="card" data-city="' + esc(p.city) + '">' +
      '<div class="img" style="background-image:url(https://images.unsplash.com/' + p.img + '?w=900&q=75)"><span class="tag">' + esc(p.tag) + '</span></div>' +
      '<div class="body"><h3>' + esc(p.name) + '</h3>' +
      '<div class="loc">&#9679; ' + esc(p.city) + '</div>' +
      '<div class="meta"><span>' + esc(p.type) + '</span><span>' + esc(p.size) + '</span></div>' +
      '<div class="actions"><button class="btn btn-dark btn-sm" type="button" data-ask="Tell me about ' + esc(p.name) + ' in ' + esc(p.city) + '">Ask concierge</button>' +
      '<button class="btn btn-sm" style="background:var(--cream);color:var(--ink)" type="button" data-ask="I would like to book a site visit at ' + esc(p.name) + '">Book a visit</button></div>' +
      '</div></article>';
  }
  document.getElementById("grid").innerHTML = html;
  var btns = document.querySelectorAll("[data-ask]");
  for (var j = 0; j < btns.length; j++){
    btns[j].addEventListener("click", function(){ askText(this.getAttribute("data-ask")); });
  }
}

function filterCity(city){
  var tabs = document.querySelectorAll(".tab");
  for (var i = 0; i < tabs.length; i++){ tabs[i].classList.toggle("on", tabs[i].getAttribute("data-city") === city); }
  var cards = document.querySelectorAll(".card");
  for (var j = 0; j < cards.length; j++){
    cards[j].classList.toggle("hide", city !== "all" && cards[j].getAttribute("data-city") !== city);
  }
}

function toast(msg){
  var t = document.getElementById("toast");
  t.textContent = msg; t.classList.add("show");
  clearTimeout(window.__toastT); window.__toastT = setTimeout(function(){ t.classList.remove("show"); }, 2600);
}

function openChat(){
  try {
    if (window.embeddedservice_bootstrap && embeddedservice_bootstrap.utilAPI) {
      embeddedservice_bootstrap.utilAPI.launchChat();
      return;
    }
  } catch (e) { console.error(e); }
  toast("The concierge is loading. Please try again in a moment.");
}

function askText(text){
  var done = function(){ toast("Copied: “" + text + "”. Paste it into the chat."); };
  try {
    if (navigator.clipboard && navigator.clipboard.writeText) { navigator.clipboard.writeText(text).then(done, done); }
    else { done(); }
  } catch (e) { done(); }
  openChat();
}
function askChat(el){ askText(el.querySelector("span").textContent); }

window.addEventListener("scroll", function(){
  document.getElementById("nav").classList.toggle("solid", window.scrollY > 40);
});
document.addEventListener("DOMContentLoaded", function(){
  renderProjects();
  var tabs = document.querySelectorAll(".tab");
  for (var i = 0; i < tabs.length; i++){
    tabs[i].addEventListener("click", function(){ filterCity(this.getAttribute("data-city")); });
  }
});

function initEmbeddedMessaging() {
  try {
    embeddedservice_bootstrap.settings.language = "en_US";
    embeddedservice_bootstrap.init(
      "00Daj00000q9M9p",
      "Housing_Service_Agent_Messaging_Voice",
      "https://wa1775550540999.my.site.com/ESWHousingServiceAgent",
      { scrt2URL: "https://wa1775550540999.my.salesforce-scrt.com" }
    );
  } catch (err) {
    console.error("Error loading Embedded Messaging: ", err);
  }
}
//]]>
</script>
<script type="text/javascript" src="https://wa1775550540999.my.site.com/ESWHousingServiceAgent/assets/js/bootstrap.min.js" onload="initEmbeddedMessaging()"></script>
</body>
</html>
</apex:page>